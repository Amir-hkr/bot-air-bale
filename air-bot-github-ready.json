    {
      "parameters": {
        "jsCode": "const updateId = Number($node['Parse Message'].json.update_id || 0);\nconst lastId = Number($node['Get Memory'].json.last_update_id || 0);\n\nif (updateId > lastId) {\n  return [{\n    json: {\n      ok: true,\n      update_id: updateId,\n      message_id: $node['Parse Message'].json.message_id,\n      text: $node['Parse Message'].json.text,\n      chat_id: $node['Parse Message'].json.chat_id\n    }\n  }];\n}\n\nreturn [];"
      },
