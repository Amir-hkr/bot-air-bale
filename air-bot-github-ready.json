      "parameters": {
        "jsCode": "const updates = $json.result || [];\nconst last = updates[updates.length - 1];\n\nif (!last) return [];\n\nreturn [{\n  json: {\n    update_id: last.update_id,\n    message_id: last.message?.message_id,\n    text: last.message?.text || '',\n    chat_id: last.message?.chat?.id || '',\n    ok: true\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "name": "Parse Message",
      "position": [
